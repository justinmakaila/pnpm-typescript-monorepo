{
  "name": "typescript-monorepo-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "22.23.4",
    "pnpm": "10.17.1"
  },
  "scripts": {
    "dev": "pnpm --filter @workspace/greeting build && pnpm --filter @workspace/hello dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm lint:root && pnpm -r --if-present lint",
    "lint:root": "eslint . --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
    "lint:fix": "pnpm lint:root --fix && pnpm -r --if-present lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:policy": "node --test scripts/*.test.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "verify": "pnpm check:workspace && pnpm format:check && pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm test:policy",
    "template:init": "node scripts/init.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.19.19",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "16.4.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1"
  }
}
